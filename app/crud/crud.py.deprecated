# app/crud.py
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy import select, update, delete, and_, or_
from sqlalchemy.exc import IntegrityError
from datetime import datetime, timedelta
import uuid

from app.models import User, Consent, Message, VerificationCode, ConsentStatus, MessageStatus, ChannelType, VerificationType
from app.schemas import UserCreate, ConsentCreate, MessageCreate, VerificationCodeCreate


# --- User CRUD ---
async def create_user(db: AsyncSession, user_data: UserCreate) -> User:
    """Создание нового пользователя"""
    user = User(
        phone=user_data.phone,
        email=user_data.email,
        full_name=user_data.full_name,
        role=user_data.role,
    )
    db.add(user)
    try:
        await db.commit()
        await db.refresh(user)
        return user
    except IntegrityError:
        await db.rollback()
        raise ValueError("User with this phone or email already exists")

async def get_user_by_phone(db: AsyncSession, phone: str) -> User | None:
    result = await db.execute(select(User).where(User.phone == phone))
    return result.scalar_one_or_none()

async def get_user_by_email(db: AsyncSession, email: str) -> User | None:
    result = await db.execute(select(User).where(User.email == email))
    return result.scalar_one_or_none()

async def get_user_by_id(db: AsyncSession, user_id: int) -> User | None:
    result = await db.execute(select(User).where(User.id == user_id))
    return result.scalar_one_or_none()

async def update_user(db: AsyncSession, user_id: int, update_data: dict) -> User | None:
    user = await get_user_by_id(db, user_id)
    if not user:
        return None
    for key, value in update_data.items():
        setattr(user, key, value)
    await db.commit()
    await db.refresh(user)
    return user

async def delete_user(db: AsyncSession, user_id: int) -> bool:
    result = await db.execute(delete(User).where(User.id == user_id))
    if result.rowcount:
        await db.commit()
        return True
    return False


# --- Consent CRUD ---
async def create_consent(db: AsyncSession, consent_data: ConsentCreate) -> Consent:
    """Создание записи о согласии (по умолчанию ALLOWED)"""
    consent = Consent(
        user_id=consent_data.user_id,
        phone=consent_data.phone,
        email=consent_data.email,
        status=ConsentStatus.ALLOWED,
    )
    db.add(consent)
    try:
        await db.commit()
        await db.refresh(consent)
        return consent
    except IntegrityError:
        await db.rollback()
        raise ValueError("Consent for this phone or email already exists")

async def get_consent_by_phone(db: AsyncSession, phone: str) -> Consent | None:
    result = await db.execute(select(Consent).where(Consent.phone == phone))
    return result.scalar_one_or_none()

async def get_consent_by_email(db: AsyncSession, email: str) -> Consent | None:
    result = await db.execute(select(Consent).where(Consent.email == email))
    return result.scalar_one_or_none()

async def update_consent_status(
    db: AsyncSession, 
    identifier: str, 
    status: ConsentStatus, 
    confirmation_code_id: int | None = None
) -> Consent | None:
    """Обновление статуса согласия по телефону или email"""
    # сначала пробуем по телефону, потом по email
    consent = await get_consent_by_phone(db, identifier)
    if not consent:
        consent = await get_consent_by_email(db, identifier)
    if not consent:
        return None
    consent.status = status
    consent.confirmed_at = datetime.utcnow()
    if confirmation_code_id:
        consent.verification_code_id = confirmation_code_id
    await db.commit()
    await db.refresh(consent)
    return consent

async def delete_consent(db: AsyncSession, identifier: str) -> bool:
    """Удаление записи согласия (например, если пользователь отозвал согласие)"""
    consent = await get_consent_by_phone(db, identifier) or await get_consent_by_email(db, identifier)
    if not consent:
        return False
    await db.delete(consent)
    await db.commit()
    return True


# --- Message CRUD ---
async def create_message(db: AsyncSession, message_data: MessageCreate, sender_phone: str) -> Message:
    """Создание записи о сообщении (одно сообщение)"""
    message = Message(
        sender_user_id=message_data.sender_user_id,
        sender_phone=sender_phone,
        recipient_phone=message_data.recipient_phone,
        recipient_email=message_data.recipient_email,
        text=message_data.text,
        channels=message_data.channels,
        order_id=message_data.order_id or uuid.uuid4(),
        status=MessageStatus.PENDING,
    )
    db.add(message)
    await db.commit()
    await db.refresh(message)
    return message

async def get_messages_by_order_id(db: AsyncSession, order_id: uuid.UUID) -> list[Message]:
    """Получить все сообщения по order_id (группа массовой отправки)"""
    result = await db.execute(select(Message).where(Message.order_id == order_id))
    return result.scalars().all()

async def get_messages_by_sender_phone(db: AsyncSession, phone: str, limit: int = 100) -> list[Message]:
    result = await db.execute(
        select(Message)
        .where(Message.sender_phone == phone)
        .order_by(Message.created_at.desc())
        .limit(limit)
    )
    return result.scalars().all()

async def get_message_by_id(db: AsyncSession, message_id: int) -> Message | None:
    result = await db.execute(select(Message).where(Message.id == message_id))
    return result.scalar_one_or_none()

async def update_message_status(db: AsyncSession, message_id: int, status: MessageStatus, error: str | None = None) -> Message | None:
    message = await get_message_by_id(db, message_id)
    if not message:
        return None
    message.status = status
    if status == MessageStatus.DELIVERED:
        message.delivered_at = datetime.utcnow()
    if error:
        message.error_message = error
    await db.commit()
    await db.refresh(message)
    return message

async def delete_old_messages(db: AsyncSession, older_than_days: int = 30):
    """Удаление старых сообщений (например, через 30 дней)"""
    cutoff = datetime.utcnow() - timedelta(days=older_than_days)
    result = await db.execute(delete(Message).where(Message.created_at < cutoff))
    await db.commit()
    return result.rowcount


# --- VerificationCode CRUD ---
async def create_verification_code(db: AsyncSession, code_data: VerificationCodeCreate) -> VerificationCode:
    """Создание кода верификации"""
    code = VerificationCode(
        user_id=code_data.user_id,
        phone=code_data.phone,
        email=code_data.email,
        code=code_data.code,
        type=code_data.type,
        expires_at=datetime.utcnow() + timedelta(minutes=5),
    )
    db.add(code)
    await db.commit()
    await db.refresh(code)
    return code

async def get_valid_verification_code(
    db: AsyncSession, 
    phone: str | None = None, 
    email: str | None = None, 
    code: str | None = None,
    type: VerificationType | None = None
) -> VerificationCode | None:
    """Найти действующий код (не истекший и не использованный)"""
    query = select(VerificationCode).where(
        and_(
            VerificationCode.used == False,
            VerificationCode.expires_at > datetime.utcnow()
        )
    )
    if phone:
        query = query.where(VerificationCode.phone == phone)
    elif email:
        query = query.where(VerificationCode.email == email)
    if code:
        query = query.where(VerificationCode.code == code)
    if type:
        query = query.where(VerificationCode.type == type)
    result = await db.execute(query)
    return result.scalar_one_or_none()

async def mark_verification_code_used(db: AsyncSession, code_id: int) -> bool:
    """Пометить код как использованный"""
    code = await db.get(VerificationCode, code_id)
    if not code:
        return False
    code.used = True
    await db.commit()
    return True

async def delete_expired_codes(db: AsyncSession):
    """Удаление просроченных кодов"""
    result = await db.execute(delete(VerificationCode).where(VerificationCode.expires_at < datetime.utcnow()))
    await db.commit()
    return result.rowcount